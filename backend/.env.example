# WasteLink Bali — Backend Environment Configuration
# Copy this file to .env and fill in real values for your environment.
# NEVER commit .env with real secrets to version control.

# --- Application ---
APP_NAME=WasteLink Bali
APP_VERSION=0.1.0
APP_ENV=local
# Options: local, test, staging, production
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# --- Database ---
# PostgreSQL connection URL
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://wastelink:change_me_local@localhost:5432/wastelink_dev
# For tests — uses a separate database
DATABASE_URL_TEST=postgresql://wastelink:change_me_local@localhost:5432/wastelink_test

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Security ---
# Session secret key — generate a strong random value (>= 64 chars) for non-local environments
SESSION_SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key_at_least_64_characters
SESSION_LIFETIME_SECONDS=86400
SESSION_COOKIE_NAME=wastelink_session
# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# CSRF protection
CSRF_SECRET_KEY=CHANGE_ME_generate_a_separate_csrf_secret_key

# --- CORS ---
# Comma-separated allowed origins. Do NOT use * with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Object Storage ---
# Storage adapter: local | s3
STORAGE_ADAPTER=local
STORAGE_LOCAL_PATH=./uploads
# S3-compatible settings (only when STORAGE_ADAPTER=s3)
# S3_ENDPOINT_URL=https://s3.example.com
# S3_BUCKET_NAME=wastelink-evidence
# S3_ACCESS_KEY_ID=CHANGE_ME
# S3_SECRET_ACCESS_KEY=CHANGE_ME
# S3_REGION=auto

# --- Upload Limits ---
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# --- OpenAPI / Docs ---
# Set to false in production to disable Swagger/ReDoc
ENABLE_DOCS=true
