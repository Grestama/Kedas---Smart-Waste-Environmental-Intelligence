# WasteLink Bali — Frontend Environment Variables Template
# JANGAN MENYIMPAN KREDENSIAL ATAU SECRET ASLI DALAM FILE INI

# Base URL API Backend WasteLink Bali (FastAPI /api/v1)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# App Environment (development, staging, production)
NEXT_PUBLIC_APP_ENV=development

# Zona Waktu Tampilan Operasional
NEXT_PUBLIC_TIMEZONE=Asia/Makassar
